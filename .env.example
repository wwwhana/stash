# Stash Configuration
# Copy this file to .env and fill in your values

# PostgreSQL connection string (required)
# Format: postgres://user:password@host:port/database?sslmode=disable
#
# For local development (outside Docker):
# STASH_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/stash?sslmode=disable
#
# For Docker Compose (use this with docker-compose.yml):
STASH_POSTGRES_DSN=postgres://stash:stash_dev_password@postgres:5432/stash?sslmode=disable

# Vector dimension - must match your embedding model (required)
# text-embedding-3-small: 1536
# The standard pgvector type used by Stash supports up to 2000 dimensions.
# Changing this or STASH_EMBEDDING_MODEL on restart automatically queues a full reindex.
STASH_VECTOR_DIM=1536

# Maximum results per query (required)
STASH_MAX_RESULT_SIZE=10000

# OpenAI-compatible API configuration
# API key is optional for local or internal endpoints without authentication.
# All STASH_OPENAI_* and model settings are optional. Without an embedding
# provider Stash still stores memories and searches them by keyword (trigram);
# vectors are computed once a provider is assigned in model settings.
STASH_OPENAI_API_KEY=
STASH_OPENAI_BASE_URL=https://api.openai.com/v1
# Maximum time for one provider request attempt. This prevents a dead or
# unavailable model endpoint from holding MCP calls indefinitely.
STASH_OPENAI_REQUEST_TIMEOUT=2m

# Atlas Cloud example:
# STASH_OPENAI_API_KEY=your-atlas-cloud-api-key
# STASH_OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# STASH_EMBEDDING_MODEL=text-embedding-3-small
# STASH_REASONER_MODEL=deepseek-ai/DeepSeek-V3-0324
# STASH_VECTOR_DIM=1536

# Embedding model (required)
# OpenAI: text-embedding-3-small, text-embedding-3-large
# OpenRouter: openai/text-embedding-3-small
STASH_EMBEDDING_MODEL=text-embedding-3-small

# Failed embeddings are stored as pending rows and retried in the background.
# Retries use exponential backoff from INTERVAL up to MAX_INTERVAL.
STASH_EMBEDDING_RETRY_INTERVAL=1m
STASH_EMBEDDING_RETRY_MAX_INTERVAL=1h
STASH_EMBEDDING_RETRY_BATCH_SIZE=100
# Maximum input window of the embedding model in tokens. Set it from the
# model's documentation; 0 lets Stash adapt after a context error.
STASH_EMBEDDING_CONTEXT_TOKENS=0

# Reasoning model for relationship extraction (required)
# OpenAI: gpt-4o-mini, gpt-4o
# OpenRouter: openai/gpt-4o-mini, google/gemma-4-26b-a4b-it
STASH_REASONER_MODEL=gpt-4o-mini
# Full context window of the reasoning model. MCP cannot discover this value.
# Stash reserves the second value for instructions and the JSON answer, then
# splits consolidation evidence before calling the model.
STASH_REASONER_CONTEXT_TOKENS=0
STASH_REASONER_RESERVED_TOKENS=4096
# Example for a 44,544-token reasoner: STASH_REASONER_CONTEXT_TOKENS=44544

# --- Ollama (fully local — see docs/LOCAL_OLLAMA.md) ---
# STASH_OPENAI_API_KEY=ollama
# STASH_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# STASH_EMBEDDING_MODEL=nomic-embed-text
# STASH_REASONER_MODEL=qwen2.5:3b
# STASH_VECTOR_DIM=768

# Memory Configuration
# Time-to-live for context (working memory windows)
# Format: 1h, 30m, 2h30m, etc.
STASH_CONTEXT_TTL=1h

# Server Configuration
# Stash server address (MCP, web console, metrics, and health checks share it)
STASH_HTTP_ADDR=127.0.0.1:8080

# Maximum JSON bytes returned by one MCP tool call. Oversized list responses
# are split and include next_offset; oversized non-list responses are omitted.
STASH_MCP_MAX_RESPONSE_BYTES=32768
# Maximum time for one MCP tool handler. Set this above the normal duration of
# your slowest model-backed operation when using a local or remote provider.
STASH_MCP_TOOL_TIMEOUT=2m

# Log level: debug, info, warn, error
# API and model-provider call records are emitted at info; ordinary web access
# records are debug-only and failures are warn. Query strings, authorization
# headers, cookies, and request bodies are never included.
STASH_LOG_LEVEL=info

# Log format: text or json
STASH_LOG_FORMAT=text

# Authentication profiles: none (local only), token (Stash API token), oauth
# (console SSO through an OIDC provider), stdio (local STDIO)
# STASH_AUTH_MODE=none  # STASH_HTTP_ADDR must stay on localhost
STASH_AUTH_MODE=token
# MCP clients always authenticate with a Stash API token stored in the
# database: issue one in the console (API tokens page) or with
# `stash mcp token --subject <agent>`. Tokens never change on their own, so an
# agent keeps its history. The oauth profile adds SSO login for the console;
# the token profile does not contact an OIDC provider.
# SSO (OIDC) for the console. These four register the first provider: the
# server copies them into the sso_providers table at startup (sealed with
# STASH_SECRETS_KEY) and administrators manage providers in the console or
# with `stash sso` from then on. Register the redirect URL at the issuer.
# STASH_AUTH_ISSUER=https://accounts.example.com
# STASH_AUTH_CLIENT_ID=stash
# STASH_AUTH_CLIENT_SECRET=replace-me
# STASH_AUTH_REDIRECT_URL=https://stash.example.com/auth/callback
STASH_AUTH_API_SECRET=
# Local HTTP uses false. Set true when the public URL uses HTTPS.
STASH_AUTH_COOKIE_SECURE=false
# Default lifetime of tokens issued by `stash mcp token` (0 means no expiry).
# STASH_AUTH_TOKEN_TTL=720h
# Browser console session lifetime; active sessions slide forward.
# STASH_AUTH_SESSION_TTL=720h
# Optional credential for the STDIO profile. The process is trusted when it is
# empty; when set, it must be a Stash API token and is checked before using
# the user's isolated namespace.
# STASH_AUTH_STDIO_TOKEN=
# The same values may be written with the explicit STASH_AUTH_OAUTH_* prefix
# (for example STASH_AUTH_OAUTH_ISSUER); the unprefixed names take precedence.

# Optional embedding maintenance access for the web console. Set either a
# comma-separated list of stable OIDC subjects or a separate static token.
# The token is sent only as X-Stash-Admin-Token and is never used for MCP.
# STASH_ADMIN_SUBJECTS=user-1,user-2
# STASH_ADMIN_TOKEN=generate-a-long-random-maintenance-token
# First console administrator. Created at startup when the account does not
# exist; a password changed later in the console is kept. The username is the
# session subject, like an OIDC subject. Add more people with `stash user add`.
# STASH_ADMIN_USER=admin
# STASH_ADMIN_PASSWORD=change-me-please
# With STASH_AUTH_MODE=none, allow listening beyond loopback (for example an
# OrbStack or LAN hostname). Everyone who can reach the port has full access.
# STASH_AUTH_TRUSTED_NETWORK=false

# Model providers
# Providers can also be registered in the database (console: Server settings,
# or `stash llm provider add`) and assigned per feature. STASH_OPENAI_* stays
# the fallback for any feature without an assignment; `stash llm import-env`
# copies it into the database. Stored API keys are sealed with this key.
# Generate once with `openssl rand -hex 32` and keep it stable.
# STASH_SECRETS_KEY=
# Comma-separated older keys that may still open existing values after rotation.
# STASH_SECRETS_KEY_PREVIOUS=
# Cache computed vectors in PostgreSQL so identical text is embedded once.
STASH_EMBEDDING_CACHE=true

# Consolidation Configuration
# Comma-separated, non-root namespaces used by Docker Compose background work.
# The root namespace (/) is rejected so unrelated session memory is not mixed.
STASH_CONSOLIDATE_NAMESPACES=/projects

# Number of events to process per consolidation run
STASH_CONSOLIDATION_BATCH_SIZE=100

# Similarity threshold for clustering events (0.0 to 1.0)
STASH_CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# Similarity threshold for detecting duplicate facts (0.0 to 1.0)
# Facts with similarity above this threshold are skipped as duplicates
STASH_CONSOLIDATION_DEDUP_THRESHOLD=0.85

# Time window for event consolidation (e.g., 168h = 7 days)
STASH_CONSOLIDATION_WINDOW=168h

# Optional: Specify custom config file location
# STASHCONFIG=/path/to/your/.env
