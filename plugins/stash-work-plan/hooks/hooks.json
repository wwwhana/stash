{
  "description": "Keep a claimed Stash work item from ending without a recorded finish or handoff.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__stash(?:[-_][^_]+)?__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stash_work_hook.py\"",
            "statusMessage": "Stash 작업 상태 저장",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stash_work_hook.py\"",
            "statusMessage": "Stash 작업 종료 확인",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/stash_work_hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
